# Teléfono y PIN de ACCESO GENERAL a Q-POS (el login inicial de la app,
# no el PIN individual de cada empleado, que se define desde la web)
ACCESS_PHONE=600000000
ACCESS_PIN=0000

# Nombre exacto del local tal cual aparece en Q-POS (el texto accesible del
# logo arriba a la izquierda tras entrar). El script lo usa para localizar
# el botón que abre la pantalla de Personal.
RESTAURANT_NAME=Botavara

# Credenciales para entrar al panel de administración de esta app
WEB_ADMIN_USER=admin
WEB_ADMIN_PASS=cambia-esto

# Clave para firmar la cookie de sesión del panel (pon un valor largo y aleatorio)
SESSION_SECRET=cambia-esto-tambien

# Puerto donde escucha el panel web
PORT=3000

# Poner en "false" para ver el navegador mientras ficha (depuración).
# En un servidor sin entorno gráfico debe quedarse en "true".
HEADLESS=true

# Ponlo en "true" SOLO cuando la app corra detrás de un proxy inverso con
# HTTPS (nginx + certbot en producción). En local (http://localhost) debe
# quedarse en "false", si no el login no funcionará.
TRUST_PROXY=false

# Opcional: notificaciones por Telegram cuando un fichaje automático no se
# puede hacer tras reintentarlo, o si el servidor tiene un error inesperado.
# Déjalas vacías para desactivar esta función. Ver README para cómo
# conseguir el token y el chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
