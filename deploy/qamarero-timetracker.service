[Unit]
Description=Qamarero Timetracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Cambia estas dos rutas y el usuario por los de tu servidor
User=CAMBIA_TU_USUARIO
WorkingDirectory=/ruta/a/qamarero-timetracker
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
